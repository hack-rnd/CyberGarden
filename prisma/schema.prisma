// use prisma-8

model AiCache {
  id           Int      @id @default(autoincrement())
  incidentHash String   @unique
  incidentId   String
  summary      String
  rootCause    String?
  actionPlan   String
  targetTeam   String?
  provider     String
  createdAt    DateTime @default(now())
}

model IncidentEvent {
  id           Int      @id @default(autoincrement())
  incidentId   String
  eventType    String
  title        String
  details      String?
  priority     String?
  assignedTeam String?
  isNotified   Int      @default(0)
  createdAt    DateTime @default(now())
}
