// --- CONFIG ---

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- MODELS ---

model AiAnalysisCache {
  id              String   @id @default(cuid())
  incidentId      String   @unique
  contentHash     String
  summary         String
  recommendedTeam String
  riskScore       Int
  riskLevel       String
  riskReason      String
  handoffMessage  String
  provider        String
  updatedAt       DateTime @updatedAt
}

model ChangeEvent {
  id           String   @id @default(cuid())
  incidentId   String
  incidentCode String
  product      String
  type         String
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model IncidentHistory {
  id         String   @id @default(cuid())
  incidentId String
  field      String
  oldValue   String?
  newValue   String
  actor      String   @default("Координатор")
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model MtsLinkMessage {
  id            String   @id @default(cuid())
  incidentId    String
  recipientName String
  recipientTeam String
  messageType   String
  title         String
  payloadJson   String
  createdAt     DateTime @default(now())

  @@index([incidentId])
  @@index([createdAt])
}